# Configuración de API Keys
# Copia este archivo a .env y agrega tus claves reales

# API Key de Anthropic (requerido para enriquecimiento con IA)
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxx

# API Key de Google Maps (opcional, para geolocalización)
# Obtén tu clave en: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx

# Configuración opcional de scraping
SCRAPING_DELAY=2  # Segundos entre peticiones
MAX_RETRIES=3     # Número máximo de reintentos
